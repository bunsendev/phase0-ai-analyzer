APP_ENV=development
UPLOAD_DIR=./data/upload
ORIGINAL_DIR=./data/original
WORK_DIR=./data/work
VALIDATION_DIR=./data/validation/actual
DATABASE_URL=sqlite:///./data/database/phase0.db
AI_PROVIDER=mock
OCR_REVIEW_REQUIRED=true
AI_MAX_COLUMNS=100
AI_MAX_INPUT_CHARS=100000
OPENAI_API_KEY=
OPENAI_MODEL=
CATEGORY_CONFIDENCE_THRESHOLD=0.80
DOCUMENT_TYPE_CONFIDENCE_THRESHOLD=0.70
FIELD_CONFIDENCE_THRESHOLD=0.75
PDF_TEXT_THRESHOLD=50
PDF_MAX_PAGES=10
TABLE_PREVIEW_MAX_ROWS=30
FILE_PREVIEW_MAX_ROWS=50
DEFAULT_USER=phase0-user
LOG_LEVEL=INFO
